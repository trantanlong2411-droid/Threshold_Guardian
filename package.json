{
  "name": "pharos-threshold-guardian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "run": "node bin/guardian.mjs --mode manual",
